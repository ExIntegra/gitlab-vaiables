# Optional settings: docker compose up -d works without a .env file.
# These two settings are used when publishing a new image.
DOCKERHUB_USERNAME=exintegra
IMAGE_NAME=ci-variables
IMAGE=exintegra/ci-variables:1.0.0

APP_PORT=8081
# APP_ORIGIN defaults to http://localhost:${APP_PORT}.
# Set it explicitly only when using another external address, such as HTTPS.
# APP_ORIGIN=https://variables.example.com
GITLAB_URL=https://gitlab.com
APP_DEMO=false
SESSION_TTL=1h
TRACKING_VOLUME=ci-variables-data

# Never put GitLab tokens or Docker Hub access tokens in this file.
